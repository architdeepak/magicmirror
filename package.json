{
  "name": "magic-mirror-portal",
  "version": "1.0.0",
  "description": "Head-tracked Magic Mirror with a talking 3D avatar, dashboard, and live AR mode",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "kiosk": "electron . --kiosk",
    "pack": "electron-builder --dir",
    "dist:win": "electron-builder --win portable",
    "test": "npm run test:syntax && npm run test:avatar && npm run test:desktop && npm run test:casting && npm run test:voice && npm run test:gestures && npm run test:youtube && npm run test:watch && npm run test:depth && npm run test:body && npm run test:settings && npm run test:companion && npm run test:desktop-gestures && npm run test:audio-turns && npm run test:tryon && npm run test:garment-geometry && npm run test:camera && npm run test:garment-cache && npm run test:hand && npm run test:mirror-state && npm run test:spotify && npm run test:live-tryon && npm run test:assistant-vision && npm run test:spotify-devices && npm run test:windows-spotify && npm run test:power && npm run test:wardrobe && npm run test:starter-sleeves",
    "test:avatar": "node tools/test-expression-mixer.mjs",
    "test:health": "node tools/healthcheck.cjs",
    "preview:capture": "electron --no-sandbox --headless --disable-gpu tools/capture-preview.cjs",
    "preview:avatar-demo": "electron --no-sandbox --headless --disable-gpu tools/capture-avatar-demo.cjs",
    "preview:avatar-video": "electron --no-sandbox --headless --disable-gpu tools/capture-avatar-video-handoff.cjs",
    "preview:rig-gate": "electron --no-sandbox --headless --disable-gpu tools/capture-persona-rig-preview.cjs",
    "preview:serve": "node tools/preview-server.cjs",
    "avatar:lab": "npm --prefix .tools/face-to-blendshape-3d run dev -- --host 127.0.0.1 --port 8790",
    "avatar:preflight": "node tools/avatar-video-preflight.cjs",
    "verify": "npm test && npm run test:health",
    "rig:check": "node tools/inspect-avatar-rig.mjs",
    "test:syntax": "node tools/check-syntax.cjs",
    "test:live-fit": "electron --no-sandbox tools/test-live-fit.cjs",
    "test:desktop": "node tools/test-desktop-harness.cjs",
    "test:desktop:windows": "electron tools/test-native-desktop.cjs",
    "test:casting": "node tools/test-casting.cjs",
    "test:cast-player": "electron --no-sandbox tools/test-cast-player.cjs",
    "test:voice": "node tools/test-voice-lifecycle.cjs",
    "test:gestures": "node tools/test-gestures.cjs",
    "test:youtube": "node tools/test-youtube-bridge.cjs",
    "check:gemini:live": "electron --no-sandbox tools/check-gemini-live.cjs",
    "test:watch": "node tools/test-watch-controls.cjs",
    "check:youtube:live": "electron --no-sandbox tools/check-youtube-live.cjs",
    "check:wake:recognition": "electron --no-sandbox tools/check-wake-recognition.cjs",
    "test:depth": "node tools/test-depth.cjs",
    "test:body": "node tools/test-body-tracking.cjs",
    "test:settings": "node tools/test-integration-settings.cjs",
    "test:companion": "node tools/test-native-companion.cjs",
    "check:companion": "electron --no-sandbox tools/check-native-companion.cjs",
    "test:desktop-gestures": "node tools/test-desktop-gestures.cjs",
    "check:packaged": "node tools/check-packaged.cjs",
    "check:voice:journey": "node tools/check-voice-journey.cjs",
    "test:audio-turns": "node tools/test-audio-turns.cjs",
    "test:tryon": "node tools/test-tryon.cjs",
    "test:garment-geometry": "node tools/test-garment-geometry.cjs",
    "test:camera": "node tools/test-camera-lifecycle.cjs",
    "test:garment-cache": "node tools/test-garment-cache.cjs",
    "test:hand": "node tools/test-hand-tracking.cjs",
    "check:hand:worker": "electron --no-sandbox tools/check-hand-worker.cjs",
    "check:face:worker": "electron --no-sandbox tools/check-face-worker.cjs",
    "test:mirror-state": "node tools/test-mirror-state.cjs",
    "test:spotify": "node tools/test-spotify-playback.cjs",
    "build:decart": "node tools/build-decart.cjs",
    "prestart": "npm run build:decart",
    "predev": "npm run build:decart",
    "prekiosk": "npm run build:decart",
    "prepack": "npm run build:decart",
    "predist:win": "npm run build:decart",
    "test:live-tryon": "node tools/test-live-tryon.cjs",
    "check:live-tryon:ui": "node tools/check-live-tryon-ui.cjs",
    "test:assistant-vision": "node tools/test-assistant-vision.cjs",
    "test:spotify-devices": "node tools/test-spotify-devices.cjs",
    "dist:win:zip": "electron-builder --win zip --x64 -c.win.signAndEditExecutable=false",
    "predist:win:zip": "npm run build:decart",
    "check:windows-package": "node tools/check-windows-package.cjs",
    "test:managed-keys": "electron --no-sandbox tools/test-managed-keys.cjs",
    "check:computer:live": "node tools/check-live-computer.cjs",
    "check:computer:form": "node tools/check-live-computer.cjs --form",
    "check:computer:scroll": "node tools/check-live-computer.cjs --scroll",
    "check:computer:double": "node tools/check-live-computer.cjs --double",
    "test:windows-spotify": "node tools/test-windows-spotify.cjs",
    "test:power": "node tools/test-render-budget.cjs",
    "check:power:ui": "node tools/check-power-ui.cjs",
    "monitor:local": "node tools/monitor-mirror.cjs",
    "test:wardrobe": "node tools/test-wardrobe-photo.cjs",
    "check:wardrobe:ui": "node tools/check-wardrobe-ui.cjs",
    "test:starter-sleeves": "node tools/test-starter-sleeves.cjs",
    "check:sleeves": "electron --no-sandbox tools/check-sleeve-ui.cjs"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "build": {
    "appId": "com.architdeepak.reflect-mirror",
    "productName": "Reflect Mirror",
    "asar": true,
    "files": [
      "src/**/*",
      "package.json",
      {
        "from": "node_modules/three/examples/jsm",
        "to": "node_modules/three/examples/jsm",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "extraFiles": [
        {
          "from": "release/windows",
          "to": ".",
          "filter": [
            "*.cmd",
            "README.txt"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "@decartai/sdk": "^0.2.5",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@met4citizen/talkinghead": "^1.7.0",
    "@pixiv/three-vrm": "^3.5.5",
    "dotenv": "^16.6.1",
    "google-auth-library": "^11.1.0",
    "qrcode": "^1.5.4",
    "three": "0.180.0",
    "vosk-browser": "^0.0.8"
  },
  "mirrorAppId": "com.architdeepak.reflect-mirror"
}
