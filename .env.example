# Optional: leave GEMINI_API_KEY blank to run the complete local demo.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_VOICE=Aoede
MIRROR_CITY=San Francisco
MIRROR_UNITS=imperial
MIRROR_KIOSK=false
MIRROR_SPOTIFY_CLIENT_ID=

# Optional virtual try-on adapter. The configured HTTPS endpoint receives a
# consented person frame plus closet garment and returns a rendered image.
# Credentials stay in Electron's main process.
MIRROR_TRYON_ENDPOINT=
MIRROR_TRYON_API_KEY=

# Optional direct Google Cloud Virtual Try-On provider. Set up billing, enable
# Vertex AI, and configure Application Default Credentials before using it.
MIRROR_VERTEX_PROJECT=
MIRROR_VERTEX_LOCATION=us-central1

# Optional live neural camera try-on through Decart. Alternatively enter this
# key in Settings. Live video starts only through consented Try On controls.
DECART_API_KEY=

# Only set this to true if a particular Windows webcam fails with Electron's
# default Media Foundation capture path. Most USB cameras should leave it off.
MIRROR_FORCE_DIRECTSHOW=false
